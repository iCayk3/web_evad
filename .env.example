# ========================================================
# EVAD - Exemplo de Configuração de Ambiente (.env.example)
# ========================================================

# Porta Web acessível no navegador
WEB_PORT=80

# Portas de infraestrutura (opcionais)
BACKEND_PORT=8081
DB_PORT=5433

# Credenciais do Banco
DB_USER=evad_user
DB_PASSWORD=evad_password
DB_NAME=evad_db
