# ========================================================
# EVAD - Variáveis de Ambiente para Docker
# ========================================================

# Porta da Interface Web no seu navegador (Host)
# Exemplo: Se definir 80, acesse http://localhost
# Se definir 3000, acesse http://localhost:3000
# Se definir 5173, acesse http://localhost:5173
WEB_PORT=80

# Porta do Servidor Backend Go (Opcional, para debug direto da API)
BACKEND_PORT=8081

# Porta externa do PostgreSQL (Opcional, para conectar com DBeaver ou pgAdmin)
DB_PORT=5433

# Credenciais do Banco de Dados PostgreSQL
DB_USER=evad_user
DB_PASSWORD=evad_password
DB_NAME=evad_db
